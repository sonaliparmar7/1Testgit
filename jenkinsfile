pipeline {
    agent any

    stages {
        stage('Clone Code') {
            steps {
                git
'https://github.com/sonaliparmar7/1Testgit.git'
            }
         }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t my-app .'
            }
         }

         stage('Run Container') {
             steps {
                 bat 'docker run -d -p 8086:80 my-app'
              }
          }
      }
 }
